# Hub portofolio — pelaporan progres fase. Salin ke .env (JANGAN commit).
# Nilai HUB_INGEST_SECRET diambil dari .env repo "portofolio".
HUB_INGEST_URL=https://m-portofolio.hgteop.easypanel.host
HUB_INGEST_SECRET=

# Opsional (bila slug/nama proyek beda dari package.json):
# HUB_PROJECT_SLUG=inar-underreporting-lab
# HUB_PROJECT_NAME=INAR Under-reporting Lab

# Aplikasi
APP_VERSION=0.1.0
PORT=3838
APP_BASE_URL=http://localhost:3838

# PDF gate. Buat hash dengan:
#   Rscript -e "cat(digest::hmac('sha256', 'PASSWORD', key=Sys.getenv('PDF_PASSWORD_SALT')))"
PDF_PASSWORD_SALT=change-me
# Kunci enkripsi PDF di image/repo (AES-256-CBC, pbkdf2). Jangan commit nilainya.
PDF_ENC_KEY=
PDF_PASSWORD_HASH=
